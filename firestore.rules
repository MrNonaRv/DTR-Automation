rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helper functions
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidDTR(data) {
      return data.keys().hasAll(['employeeIdOrName', 'records', 'userId', 'updatedAt'])
        && data.employeeIdOrName is string
        && data.employeeIdOrName.size() <= 200
        && data.records is list
        && data.records.size() <= 500
        && data.userId is string
        && data.userId.size() <= 128;
    }

    match /dtr_records/{recordId} {
      allow read, write: if true;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
